# 과제 발굴 agent 가 사용하는 Claude API 키
ANTHROPIC_API_KEY=sk-ant-...

# 과제 발굴에 사용할 모델
OI_MODEL=claude-sonnet-4-6

# SQLite 파일 경로 (기본: backend/oi_scout.db)
OI_DB_PATH=oi_scout.db

# CORS 허용 오리진 (프론트 개발 서버)
OI_CORS_ORIGINS=http://localhost:5173

# ── 지식 파밍(크롤러) ──
# OpenDART API 키 (https://opendart.fss.or.kr 무료 발급). 없으면 DART 소스 skip.
DART_API_KEY=
# SEC EDGAR 필수 User-Agent — "앱이름 연락이메일" 형식. 없으면 SEC 소스 skip.
SEC_USER_AGENT=oi-scout-dev your-email@example.com
# 크롤 대상 기간(일)
CRAWL_SINCE_DAYS=30
