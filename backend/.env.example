# ── 과제 발굴 · 평가 · 제안 agent ──
# provider 는 OI_TASK_PROVIDER(기본 codex-cli)가 정합니다. SK 사내망은 codex 만 허용하므로
# 기본 설정에서 아래 두 값은 쓰이지 않습니다 — codex 는 OI_MODEL 을 무시하고 OI_CODEX_MODEL
# 만 봅니다. OI_CODEX_ONLY=0 으로 두고 사외에서 실험할 때만 필요합니다.
ANTHROPIC_API_KEY=
OI_MODEL=claude-sonnet-4-6

# ── 지식 파밍 정제 ──
# 파밍 단계만 provider 가 다릅니다. 설정이 없거나 실패하면 naive 요약(제목/본문 절삭)으로
# 폴백하므로 파이프라인 자체는 그대로 동작합니다.
#
#   codex-cli  : 로컬에 설치된 Codex CLI 를 `codex exec` 로 호출. **API 키가 아니라 ChatGPT
#                로그인**을 씁니다(`codex login status` 로 확인, rc=0 이어야 함).
#                --output-schema 로 응답 JSON 형태를 강제하므로 파싱 재시도가 없습니다.
#                호출당 9~15초.
#   claude-cli : 로컬에 설치된 Claude Code 를 `claude -p` 로 호출. 별도 API 키가 필요 없고
#                본인 Claude Code 로그인을 씁니다. 호출당 20~35초 → 배치 전용.
#   openai     : OpenAI API. OPENAI_API_KEY 필요.
OI_LLM_PROVIDER=codex-cli
# 과제 발굴이 쓸 provider. 파밍과 분리해 둬서 한쪽이 막혀도 다른 쪽이 멈추지 않습니다.
OI_TASK_PROVIDER=codex-cli
# ── 재생성(POST /api/proposals/regenerate) 의 LLM 발굴 ──
# 0 이면 LLM 을 아예 안 쓰고 항상 후보 풀 폴백(재생성 1초 미만).
OI_REGEN_LLM=1
# 한 번의 재생성에서 발굴할 계열사 수 = LLM 호출 수. 동시 실행이므로 3 을 넘기지 마세요.
OI_REGEN_OCS=2
# 계열사당 과제 건수
OI_REGEN_TASKS=2
# 계열사 1건을 기다리는 상한(초). 실측 104~155초라 240 이면 재시도 1회분 여유가 있습니다.
OI_REGEN_TIMEOUT=240

# 모델명은 provider 규칙을 따릅니다 (claude-cli: claude-haiku-4-5 / openai: gpt-4.1-mini 등)
# codex-cli 는 이 값을 무시하고 아래 OI_CODEX_MODEL 만 봅니다.
OI_LLM_MODEL=claude-haiku-4-5
# 동시 실행 수. CLI provider 는 프로세스를 띄우므로 과하게 올리지 마세요.
# 실측: codex 프로세스당 RSS 134MB, 3병렬 7.1초. 4 이상은 서버측 rate limit 에 걸릴 수 있습니다.
OI_LLM_CONCURRENCY=3
# 1건당 타임아웃(초). claude-cli/openai 용입니다 (codex 는 OI_CODEX_TIMEOUT).
OI_LLM_TIMEOUT=180

# ── LLM provider 정책 ──
# SK 사내망은 **codex 만 허용**합니다. 1(기본)이면 codex 가 아닌 provider 를 ready() 가
# 거부해, 잘못 설정했을 때 조용히 naive 폴백으로 떨어지는 대신 큰 소리로 실패합니다.
# 사외 개발 환경에서 claude-cli/anthropic/openai 로 실험할 때만 0 으로 두세요.
OI_CODEX_ONLY=1
# 추론 강도 low / medium / high / xhigh. codex 기본값 xhigh 는 매우 느립니다 —
# 실측(발굴 프롬프트 4,573토큰 1건): xhigh 174~197초 / medium 58~62초 / low 38~41초.
OI_CODEX_EFFORT=medium

# ── codex-cli 설정 ──
# ⚠ 인증은 API 키가 아니라 `codex login`(ChatGPT 계정)이고, 인증 정보는 CODEX_HOME(~/.codex)
#   에 있습니다. CODEX_HOME 을 읽을 수 없는 환경 — 다른 사용자 계정, docker, systemd —
#   에서는 설치돼 있어도 "Not logged in" 이 되어 provider 가 통째로 죽습니다.
#   → 서비스 계정으로 `codex login` 을 한 번 돌리거나 CODEX_HOME 을 그 계정이 읽을 수 있게 두세요.
#     (SK 사내망은 codex 만 허용하므로 다른 provider 로 바꾸는 것은 대안이 아닙니다.)
OI_CODEX_BIN=codex
# 빈 값이면 -m 플래그를 붙이지 않고 codex 기본 모델을 씁니다.
# claude 모델 별칭을 여기 넣으면 안 됩니다 (codex -m 이 인식하지 못합니다).
OI_CODEX_MODEL=
# 1건당 타임아웃(초). 파밍 정제(프롬프트 300자)는 실측 9~15초지만,
# 과제 발굴은 RAG 컨텍스트 6,000자 + 11필드×2건이라 실측 100~155초입니다(동시 2건 기준).
# 120 으로 두면 발굴이 항상 타임아웃 → 후보 풀 폴백으로 떨어집니다.
OI_CODEX_TIMEOUT=300
# rc!=0 일 때 재시도 횟수(1s·3s 백오프). 401 이 산발적으로 났다가 회복되는 사례가 있습니다.
OI_CODEX_RETRY=2
# 1이면 --ignore-user-config 를 붙입니다. 기본 0 — 이 플래그가 401 을 유발한다는 관측이 있고,
# 저장소 오염 방지는 --ephemeral + 빈 작업 디렉터리로 이미 확보됩니다.
OI_CODEX_IGNORE_USER_CONFIG=0

# provider=openai 일 때만 필요
OPENAI_API_KEY=
# OpenAI 호환 게이트웨이를 쓸 때만 지정 (사내 프록시 등). 보통 비워둡니다.
OI_LLM_BASE_URL=

# SQLite 파일 경로 (기본: backend/oi_scout.db)
OI_DB_PATH=oi_scout.db

# CORS 허용 오리진 (프론트 개발 서버)
OI_CORS_ORIGINS=http://localhost:5173

# ── 지식 파밍(크롤러) ──
# OpenDART API 키 (https://opendart.fss.or.kr 무료 발급). 없으면 DART 소스 skip.
DART_API_KEY=
# SEC EDGAR 필수 User-Agent — "앱이름 연락이메일" 형식. 없으면 SEC 소스 skip.
SEC_USER_AGENT=oi-scout-dev your-email@example.com
# 크롤 대상 기간(일)
CRAWL_SINCE_DAYS=30

# 기준일. **빈 값이 정상**입니다 — 값을 주는 것은 데모 재현용뿐입니다.
# 고정값이면 오늘 수집한 항목이 발굴의 최근 30일 창 밖으로 밀려 제외됩니다.
# 코드 기본값도 빈 값입니다(config.TODAY). 예전 기본값 "2026-07-30" 은 .env 가 없는
# 환경(배포·CI·docker)에서 기준일을 데모 시드에 고착시켰습니다.
# ★ 화면 기준일(bootstrap.today)과 NEW 배지는 상수가 아니라 config.today_local() 을
#   매 요청 호출하므로, 서버를 며칠 띄워 둬도 부팅일에 굳지 않습니다.
OI_TODAY=

# '오늘' 판정에 쓰는 로컬 시간대 오프셋(시). feed_item.farmed_at 은 **UTC 로 저장**하고
# 해석(오늘 크롤분인가 · keyword_daily 의 day 축)만 이 축으로 합니다.
# 'localtime' 을 쓰지 않는 이유: 서버 TZ 에 의존해 docker 에서 깨집니다.
OI_UTC_OFFSET_HOURS=9

# 과제 중복 판정의 이름 유사도 임계값(SequenceMatcher). 같은 계열사·같은 레버일 때만 봅니다.
# 0.70 은 실측 근거가 있습니다 — 같은 (계열사,레버) 45쌍 전수에서 진짜 중복 0.85 /
# 유일한 오탐 0.645('육상운송'↔'해상운송' 계약 재협상) / 그 외 최고 0.357.
OI_DUP_SIMILARITY=0.70

# ── 인증 ──
# 로그인 토큰 서명 키. 운영에서는 반드시 임의의 긴 문자열로 바꾸세요.
OI_AUTH_SECRET=dev-insecure-secret-change-me
# 토큰 유효기간(시간). 기본 7일
OI_AUTH_TTL_HOURS=168

# ── 프론트 서빙 ──
# 1이면 FastAPI 가 frontend/dist 를 함께 서빙합니다 (uvicorn 하나로 화면까지 뜸).
# 개발 중에는 0 으로 두고 Vite dev 서버(5173)를 쓰세요.
#
# ⚠ 켜기 전에 반드시 `cd frontend && npm run build` 를 돌리세요. 서빙되는 것은
#   frontend/public/trendroom.html 이 아니라 **frontend/dist/trendroom.html** 입니다.
#   재빌드를 빼먹으면 이 플래그를 켠 사람만 옛 화면(삭제된 /api/admin/members 를 부르고
#   bootstrap 이 더는 안 내리는 themes·evTheme·admins·evalCriteria 를 읽는 판)을 받습니다.
OI_SERVE_FRONTEND=0

# ── 과제 평가 ──
# LLM 채점 1회에 넣는 과제 수. 올리면 응답이 길어져 중간에서 잘리고,
# 파싱이 실패하면 그 배치 전부가 규칙 폴백으로 떨어집니다. 8 은 실측 안전선.
OI_EVAL_BATCH=8

# ── RAG 프롬프트 토큰 예산 (app/pipeline/knowledge/prefetch.py) ──
# 블록별 상한. 합계 6,600 토큰 — 계층1 INDEX 전체(64,252토큰)를 매 호출 싣는 것의 1/10.
# 넘치면 블록을 뒤에서 잘라냅니다. 아래는 전부 기본값이라 그대로 두어도 됩니다.
#OI_RAG_ROLE_TOKENS=400        # 역할·판단 규칙(SYSTEM)
#OI_RAG_LEVER_TOKENS=400       # 레버 체계 7행
#OI_RAG_PROFILE_TOKENS=200     # 계열사 프로필
#OI_RAG_KB_LIST_TOKENS=1400    # 내부 지식 목록
#OI_RAG_KB_BODY_TOKENS=1300    # 내부 지식 본문 발췌
#OI_RAG_UPLOAD_TOKENS=800      # 업로드 자료 발췌
#OI_RAG_CASE_TOKENS=800        # 검증된 혁신 사례
#OI_RAG_FEED_TOKENS=1000       # 외부 동향
#OI_RAG_NOTE_TOKENS=300        # 사용자 메모
#OI_RAG_TOTAL_TOKENS=6600      # 전체 상한 (build_context 가 마지막에 한 번 더 절삭)
# 내부 지식 본문을 실제로 여는 문서 수와 문서당 절삭 글자 수.
# 문서당 평균 939토큰 / 최대 3,822토큰이라 절삭 없이 2건을 열면 예산을 넘깁니다.
#OI_RAG_KB_OPEN_DOCS=2
#OI_RAG_KB_DOC_CHARS=2500

# ── 그 외 ──
# 뉴스 본문 요청 시 보낼 User-Agent (미지정 시 기본값)
#OI_NEWS_USER_AGENT=
# Google News 진입 경로(RSS·기사 셸·batchexecute)는 robots.txt 금지 대상입니다.
# 사내 검증 중이라 기본 0(현행 유지). 1 로 두면 뉴스 소스를 통째로 건너뜁니다.
# ★ 외부 배포 전에는 1 로 두거나 정식 뉴스 API 로 교체하십시오.
#OI_NEWS_ROBOTS_STRICT=0
# OI_SERVE_FRONTEND=1 일 때 서빙할 디렉터리 (기본 frontend/dist)
#OI_FRONTEND_DIST=

# ── 공공데이터포털(data.go.kr) 서비스키 ──
# 금융위원회 시세정보 API. 계정 인증키 하나가 **활용신청한 서비스에만** 통한다.
# 주가 티커에는 '금융위원회_주식시세정보'(GetStockSecuritiesInfoService) 활용신청이 필요하다.
# 두 값 모두 두는 이유: requests 의 params 로 넘길 때는 Decoding(원문),
# URL 문자열에 직접 이어 붙일 때는 Encoding(URL 인코딩) 값을 써야 이중 인코딩을 피한다.
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_SERVICE_KEY_ENCODED=
